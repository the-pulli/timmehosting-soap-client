{
    "name": "pulli/timmehosting-soap-client",
    "description": "ISPConfig SOAP Remote API SDK for TimmeHosting (and any ISPConfig-managed panel)",
    "keywords": [
        "pulli",
        "timmehosting-soap-client",
        "ispconfig",
        "soap",
        "sdk",
        "timmehosting"
    ],
    "homepage": "https://github.com/the-pulli/timmehosting-soap-client",
    "license": "MIT",
    "authors": [
        {
            "name": "PuLLi",
            "email": "the@pulli.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-soap": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.1",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Pulli\\TimmeSoapClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pulli\\TimmeSoapClient\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "install-hooks": [
            "@php -r \"if (is_dir('.git')) { passthru('git config core.hooksPath .githooks'); echo 'Git pre-commit hook activated.', PHP_EOL; }\""
        ],
        "post-install-cmd": [
            "@install-hooks"
        ],
        "post-update-cmd": [
            "@install-hooks"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
